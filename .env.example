# ------------------------------------------------------------------
# DATABASE (Prisma + SQLite)
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# NEXTAUTH
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------
# ADMIN LOGIN
# ------------------------------------------------------------------
# Username stays plain text.
# Password is NEVER stored as plain text — you generate a bcrypt hash
# once with `npm run hash-password` and paste the hash here.
ADMIN_USERNAME="asadmughal8626"
ADMIN_PASSWORD_HASH="paste-the-generated-bcrypt-hash-here"

# ------------------------------------------------------------------
# EMAIL (Resend) — used to send the signup verification email
# ------------------------------------------------------------------
# 1. Sign up free at https://resend.com
# 2. Dashboard -> API Keys -> Create API Key -> copy it here
# 3. You do NOT need to verify a domain to get started — leave
#    RESEND_FROM_EMAIL unset and it will use Resend's shared test
#    sender (onboarding@resend.dev), which works immediately.
RESEND_API_KEY="paste-your-resend-api-key-here"
RESEND_FROM_EMAIL="PrintPro Solutions <onboarding@resend.dev>"
