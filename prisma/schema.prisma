// PrintPro Solutions Lahore — Prisma schema
// Database: SQLite (file-based, zero-config, perfect for a single-server VPS
// deployment; swap the datasource to postgresql for Vercel + Neon/Supabase
// if you outgrow SQLite — see README "Deploying to Vercel").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

// ---------------------------------------------------------------------------
// Products — photocopiers / printers available for rent or sale
// ---------------------------------------------------------------------------
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float // monthly rental price in PKR
  priceLabel  String   @default("/month") // e.g. "/month", "one-time"
  category    String   @default("Photocopier") // Photocopier | Printer | Toner | Accessory
  description String
  specs       String? // newline-separated spec lines, e.g. "35 ppm\nDuplex printing\nA3 support"
  imageUrl    String // base64 data URL or an external https URL
  featured    Boolean  @default(false)
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Services — the cards shown in the "Our Services" section (homepage +
// /services page). Admin-editable so images/text can change without code.
// ---------------------------------------------------------------------------
model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  order       Int      @default(0) // lower shows first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Client logos — "Trusted By" strip on the homepage
// ---------------------------------------------------------------------------
model ClientLogo {
  id        String   @id @default(cuid())
  name      String // company name, shown under/beside the logo
  logoUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Testimonials shown on the homepage
// ---------------------------------------------------------------------------
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String
  message   String
  rating    Int      @default(5) // 1-5
  imageUrl  String? // optional client / avatar photo
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Contact form submissions — visible in the admin dashboard
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SiteContent — a single editable row holding every piece of copy that the
// admin dashboard can change (hero text, about text, contact details, SEO).
// We always read/write the row with id = "main".
// ---------------------------------------------------------------------------
model SiteContent {
  id String @id @default("main")

  // Branding / SEO
  companyName String @default("G Documents Solution")
  logoUrl     String @default("/logos/company-logo.png")
  seoTitle    String @default("G Documents Solution | Rental Photocopier Service in Pakistan")
  seoDescription String @default("G Documents Solution offers the best rental photocopier service in Pakistan, supplying Ricoh, Xerox and Canon copiers on rent for banks, universities and offices in Lahore, with toner supply, on-site repair and certified PaperCut print management.")
  seoKeywords String @default("rental photocopier service in Pakistan, photocopier rental Lahore, printer rental Pakistan, Ricoh 3510 on rent, Xerox photocopier rental, copier rental for banks, copier rental for universities, PaperCut NG MF Pakistan, toner supply Lahore, printer repair Lahore, best photocopier rental company Pakistan")

  // About Us / Our Vision / Our Mission / Our Promise (shown on homepage)
  visionText  String @default("To be Pakistan's most trusted name in office printing technology — the first company businesses think of when they need a photocopier they can rely on.")
  missionText String @default("To keep every client printing without interruption, through genuine equipment, honest pricing, and support that actually shows up.")
  promiseText String @default("If your machine goes down, we're on-site the same day. No excuses, no long waits — that's our commitment to every client we serve.")

  // Homepage hero
  heroTitle    String @default("Pakistan’s Trusted Rental Photocopier Service")
  heroSubtitle String @default("PrintPro Solutions Lahore supplies and maintains Ricoh, Xerox and Canon photocopiers for banks, universities and corporate offices across Pakistan, on flexible monthly rental plans with same-day support.")
  heroImageUrl String @default("https://images.unsplash.com/photo-1580894732444-8ecded7900cd?q=80&w=1920&auto=format&fit=crop")

  // About page
  aboutTitle    String @default("Pakistan's Trusted Photocopier Rental Partner")
  aboutText     String @default("For over a decade, PrintPro Solutions Lahore has been supplying, renting and maintaining photocopiers and printers for banks, universities, schools and corporate offices across Pakistan. We specialise in high-volume machines like the Ricoh MP 3510 and Xerox WorkCentre series, backed by genuine toner supply, on-site repair and PaperCut print-management integration, so your office never stops printing.")
  aboutImageUrl String @default("https://images.unsplash.com/photo-1568992687947-868a62a9f521?q=80&w=1600&auto=format&fit=crop")

  // Services intro (individual services are defined in code, this is the
  // page intro paragraph so it stays editable from the dashboard)
  servicesIntro String @default("From monthly photocopier rental to enterprise print-management with PaperCut, we cover every stage of your office printing needs, sales, service and support, all under one roof in Lahore.")

  // Contact information
  contactName    String @default("Asad Mughal")
  contactPhone   String @default("0335-1720842")
  contactEmail   String @default("info@printprolahore.com")
  contactAddress String @default("Lahore, Pakistan")

  // Homepage "growth" stats — shown as animated counters
  statMachines  Int @default(500) // "500+ Machines Supplied"
  statClients   Int @default(150) // "150+ Business Clients"
  statYears     Int @default(10)  // "10+ Years of Service"
  statRetention Int @default(98)  // "98% Client Retention"

  // PaperCut highlight section
  paperCutTitle String @default("Certified PaperCut Print Management")
  paperCutText  String @default("We install, configure and support PaperCut NG and PaperCut MF across your entire fleet — giving you full visibility into who prints what, enforceable quotas, secure pull-printing, and detailed cost-center reporting. Trusted by universities and enterprises worldwide, and fully integrated with every Ricoh and Xerox machine we deploy.")

  updatedAt DateTime @updatedAt
}
